<text x="233.0" y="183.6" font-size="11" fill="#3a6ea5" text-anchor="middle">木筏</text>
<text x="345.7" y="152.4" font-size="11" fill="#3a6ea5" text-anchor="middle">桥</text>
<text x="458.3" y="121.3" font-size="11" fill="#3a6ea5" text-anchor="middle">铁路</text>
<text x="571.0" y="90.2" font-size="11" fill="#3a6ea5" text-anchor="middle">蒸汽锯</text>
<text x="683.7" y="59.0" font-size="11" fill="#3a6ea5" text-anchor="middle">远征</text>
