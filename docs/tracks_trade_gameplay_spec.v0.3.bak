<text x="266" y="106" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">大林</text>
<text x="494" y="106" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">大林</text>
<text x="266" y="502" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">大林</text>
<text x="151" y="304" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">大林</text>
<text x="609" y="304" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">密林</text>
<text x="571" y="370" font-size="11" font-weight="800" fill="#e9f3dd" text-anchor="middle">密林</text>
